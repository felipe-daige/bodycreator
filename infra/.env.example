# Modelo do .env de produção. Copie para .env (NUNCA versione o .env real —
# ele contém segredos e fica só no VPS, em /opt/bodycreator/.env) e preencha
# os valores.
#
# Este único arquivo serve dois papéis:
#   1. O Docker Compose lê os valores abaixo para substituir ${VAR} dentro de
#      docker-compose.yml (POSTGRES_USER, GH_REPO, TAG, API_DOMAIN...).
#   2. env_file: [.env] injeta as MESMAS variáveis dentro do container da
#      API em tempo de execução. O Caddy recebe somente API_DOMAIN.
#
# ATENÇÃO: env_file NÃO expande ${VAR} referenciando outra variável deste
# mesmo arquivo (isso só acontece na interpolação do docker-compose.yml, não
# dentro do próprio .env). Por isso POSTGRES_PASSWORD e DATABASE_URL abaixo
# precisam repetir o mesmo valor por extenso — não é engano, é necessário.

# --- Imagem a publicar (usado por docker-compose.yml) ---
# Nome do repositório no GHCR em minúsculas, ex.: seuusuario/bodycreator
GH_REPO=
# Tag da imagem a rodar. "latest" acompanha o deploy automático da main.
# Para rollback, fixe aqui o sha da imagem anterior (ver docs/OPERACAO.md).
TAG=latest

# Domínio público da API consumida pelo app iOS.
# Precisa apontar (DNS A/AAAA) para o IP do VPS antes de subir o Caddy,
# senão a emissão automática do certificado TLS falha.
API_DOMAIN=api.seudominio.com.br

# --- Banco de dados (usado pelo compose E repassado ao container da API) ---
POSTGRES_USER=bodycreator
POSTGRES_PASSWORD=troque-por-uma-senha-forte-e-unica
POSTGRES_DB=bodycreator
# Mesmo usuário/senha/db de cima, escritos como URL — ver aviso acima.
DATABASE_URL=postgres://bodycreator:troque-por-uma-senha-forte-e-unica@db:5432/bodycreator

# --- Config da API (server/src/config.ts) ---
NODE_ENV=production
PORT=3000
# Gere com: openssl rand -base64 32
SESSION_SECRET=
# O convite abre diretamente o app iOS, sem formulário web intermediário.
PUBLIC_APP_INVITE_URL=bodycreator://convite

# --- Armazenamento de imagens (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- E-mail transacional (convites) ---
MAIL_FROM=nao-responda@seudominio.com.br
RESEND_API_KEY=

# ADMIN_SEED_EMAIL / ADMIN_SEED_PASSWORD propositalmente NÃO ficam aqui.
# São passadas na hora, só na primeira vez, como -e no comando de seed — ver
# docs/OPERACAO.md. Deixá-las num .env persistente é um jeito de vazar a
# senha do primeiro admin para qualquer coisa que leia esse arquivo depois.
