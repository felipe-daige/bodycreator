# Build de produção da API (server/). Contexto de build é a raiz do repo
# (docker build -f infra/Dockerfile.api .) para poder copiar server/ isolado
# do resto do monorepo (fontes do app iOS nunca entram nesta imagem).
FROM node:22-slim AS build
WORKDIR /app
COPY server/package*.json ./
RUN npm ci
COPY server/ ./
RUN npm run build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY server/package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
COPY --from=build /app/drizzle ./drizzle
USER node
EXPOSE 3000
CMD ["node", "dist/server.js"]
